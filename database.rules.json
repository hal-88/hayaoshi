{
  "rules": {
    ".read": false,
    ".write": false,

    "players": {
      ".read": "auth != null",
      ".indexOn": ["totalPoints"],
      "$key": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['name', 'totalPoints']) && $key.length <= 40",
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 10" },
        "avatar": {
          ".validate": "newData.hasChildren(['face', 'skin', 'eyes', 'brows', 'nose', 'mouth', 'hair', 'hairColor'])",
          "$part": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 20" }
        },
        "equipped": {
          "head": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "face": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "$other": { ".validate": false }
        },
        "totalPoints": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000" },
        "accessories": {
          "$id": { ".validate": "newData.val() === true && $id.length <= 20" }
        },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "rankings": {
      ".read": "auth != null",
      "$subject": {
        ".validate": "$subject === 'kokugo' || $subject === 'sansu' || $subject === 'shakai' || $subject === 'rika' || $subject === 'all'",
        ".indexOn": ["best"],
        "$key": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['name', 'best']) && $key.length <= 40",
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 10" },
          "best": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1500" },
          "avatar": {
            "$part": { ".validate": "(newData.isNumber() && newData.val() >= 0 && newData.val() < 20) || $part === 'equipped'" },
            "equipped": {
              "head": { ".validate": "newData.isString() && newData.val().length <= 20" },
              "face": { ".validate": "newData.isString() && newData.val().length <= 20" },
              "$other": { ".validate": false }
            }
          },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },

    "rooms": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null",
        ".validate": "$code.matches(/^[0-9]{4}$/) && newData.hasChildren(['hostUid', 'createdAt', 'status'])",
        "hostUid": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "status": { ".validate": "newData.val() === 'waiting' || newData.val() === 'playing' || newData.val() === 'finished'" },
        "finishedAt": { ".validate": "newData.isNumber()" },
        "game": { ".validate": "newData.isNumber()" },
        "settings": {
          "subject": { ".validate": "newData.val() === 'kokugo' || newData.val() === 'sansu' || newData.val() === 'shakai' || newData.val() === 'rika' || newData.val() === 'all'" },
          "target": { ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 10" },
          "speed": { ".validate": "newData.val() === 'slow' || newData.val() === 'normal' || newData.val() === 'fast'" },
          "$other": { ".validate": false }
        },
        "qids": {
          "$i": { ".validate": "newData.isString() && newData.val().length <= 40" }
        },
        "players": {
          "$uid": {
            ".validate": "newData.hasChildren(['name', 'joinedAt']) && $uid.length <= 128",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 10" },
            "avatar": {
              "$part": { ".validate": "(newData.isNumber() && newData.val() >= 0 && newData.val() < 20) || $part === 'equipped'" },
              "equipped": {
                "head": { ".validate": "newData.isString() && newData.val().length <= 20" },
                "face": { ".validate": "newData.isString() && newData.val().length <= 20" },
                "$other": { ".validate": false }
              }
            },
            "score": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
            "correct": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "buzzSum": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "buzzCount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "online": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "current": {
          "index": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "questionId": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "phase": { ".validate": "newData.val() === 'reading' || newData.val() === 'answering' || newData.val() === 'reveal'" },
          "startAt": { ".validate": "newData.isNumber()" },
          "fromChar": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "revealAt": { ".validate": "newData.isNumber()" },
          "buzzer": {
            "uid": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "charIndex": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "at": { ".validate": "newData.isNumber()" },
            "deadline": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          },
          "lockedOut": {
            "$uid": { ".validate": "newData.isBoolean() && $uid.length <= 128" }
          },
          "miss": {
            "uid": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "input": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "charIndex": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "$other": { ".validate": false }
          },
          "result": {
            "kind": { ".validate": "newData.val() === 'correct' || newData.val() === 'timeup' || newData.val() === 'allwrong'" },
            "uid": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "input": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "charIndex": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },
        "stamps": {
          "$id": {
            ".validate": "newData.hasChildren(['uid', 'stampId', 'at'])",
            "uid": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "stampId": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 8" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
